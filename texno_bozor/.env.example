# TEXNO BOZOR — maxfiy konfiguratsiya namunasi.
# Bu fayldan nusxa olib, kerakli qiymatlarni to'ldiring.
# Hech qachon haqiqiy API kalitni repositoryga joylamang!

# TEXNO AI (OpenAI-uyg'un API). Bo'sh qoldirilsa AI sozlamalardan kiritiladi.
TEXNO_AI_API_KEY=
TEXNO_AI_BASE_URL=https://api.openai.com/v1
TEXNO_AI_MODEL=gpt-4o-mini

# Ma'lumot manbai: local (offline SQLite) yoki remote (REST API + PostgreSQL).
# Ilovaning Profil > Sozlamalar > "Ma'lumot manbai" bo'limidan ham o'zgartiriladi.
API_MODE=local
API_BASE_URL=https://api.texnobozor.uz/v1
API_TOKEN=
